<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <include android:id="@+id/topbar" layout="@layout/view_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- v1.3.3：分段胶囊式切换（iOS style，灰底圆角 + 选中白底滑块） -->
            <LinearLayout
                android:id="@+id/mode_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_seg"
                android:padding="4dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tab_normal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <TextView
                        android:id="@+id/tv_tab_normal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="✅ 普通打卡"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_journal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <TextView
                        android:id="@+id/tv_tab_journal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="📔 日记打卡"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 模式说明（灰字，不套卡片） -->
            <TextView
                android:id="@+id/tv_mode_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:text="普通打卡：按规则打卡，有缺卡与连续天数。\n日记打卡：日记式记录，只记成功、可多次记录、不记缺卡、不设排期。"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 名称卡：标题在白卡内 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="打卡名称"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:hint="例如：早起、跑步、戒手机"
                    android:inputType="text"
                    android:maxLength="20"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="11dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />
            </LinearLayout>

            <!-- 主题卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="主题"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/theme_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- v1.3.0 日记 tab：记录类型单选 + 心情折线图开关 -->
            <LinearLayout
                android:id="@+id/journal_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="记录类型"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rb_journal_suixinsui"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:checked="true"
                        android:text="📔 随心记"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <!-- v1.3.3：随心记的方式开关（拍照/文字/语音）动态插入到这两个单选项之间 -->
                    <LinearLayout
                        android:id="@+id/journal_methods"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <RadioButton
                        android:id="@+id/rb_journal_mood"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="😊 心情日记（5 档心情 + 可选文字）"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <CheckBox
                        android:id="@+id/cb_mood_chart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="心情折线图（当日多条心情时在备注栏画趋势线，随时可改）"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- 打卡方式卡（普通 tab） -->
            <LinearLayout
                android:id="@+id/method_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/tv_method_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="打卡方式（可多选组合）"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_method_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="打开开关即启用；与已选方式互斥的会自动置灰。多选即组合打卡，需逐一完成。"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <LinearLayout
                    android:id="@+id/method_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 频率与规则卡 -->
            <LinearLayout
                android:id="@+id/rule_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tv_rule_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="频率与规则"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="每日打卡次数"
                        android:textColor="@color/text_primary" />
                    <Button
                        android:id="@+id/btn_limit_minus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:insetTop="0dp" android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="-"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:id="@+id/tv_limit"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/btn_limit_plus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:insetTop="0dp" android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:layout_marginVertical="6dp" android:background="@color/divider" />

                <RadioButton
                    android:id="@+id/cb_negative"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="负打卡（状态反转：无操作=成功，主动记录=破戒失败）"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/cb_time_window"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="固定时间段打卡（仅窗口内可打卡成功，如 5:00–8:30 早起）"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/tw_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开始  " android:textColor="@color/text_secondary"/>
                        <Button android:id="@+id/btn_tw_start" android:layout_width="wrap_content" android:layout_height="wrap_content" android:insetTop="0dp" android:insetBottom="0dp" android:text="05:00" android:textColor="@color/brand_dark"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="结束  " android:textColor="@color/text_secondary"/>
                        <Button android:id="@+id/btn_tw_end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:insetTop="0dp" android:insetBottom="0dp" android:text="08:30" android:textColor="@color/brand_dark"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_tw_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:text="仅在所选时间段内可打卡成功；不支持跨天（如 23:00–01:00）；开启后将无法选择自动打卡。" />
                </LinearLayout>

            </LinearLayout>

            <!-- 打卡日期卡 -->
            <LinearLayout
                android:id="@+id/schedule_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/tv_schedule_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="打卡日期"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/schedule_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 抵消机制卡 -->
            <LinearLayout
                android:id="@+id/offset_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tv_offset_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连续打卡抵消机制"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cb_offset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="开启抵消机会（🛡️可补漏签）"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/offset_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <RadioGroup
                        android:id="@+id/rg_offset_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rb_mode_a" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="模式A 累积型：每连续N天得1次，可累积" android:textColor="@color/text_primary"/>
                        <RadioButton android:id="@+id/rb_mode_b" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="模式B 阈值型：连续达N天补满k次（不叠加）" android:textColor="@color/text_primary"/>
                        <RadioButton android:id="@+id/rb_mode_c" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="模式C 周期型：每N天周期得k次" android:textColor="@color/text_primary"/>
                    </RadioGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="连续天数 N=" android:textColor="@color/text_primary"/>
                        <EditText android:id="@+id/et_offset_n" android:layout_width="70dp" android:layout_height="wrap_content" android:background="@drawable/bg_input" android:inputType="number" android:padding="10dp" android:text="3" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_k_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="次数 k=" android:textColor="@color/text_primary"/>
                        <EditText android:id="@+id/et_offset_k" android:layout_width="70dp" android:layout_height="wrap_content" android:background="@drawable/bg_input" android:inputType="number" android:padding="10dp" android:text="1" android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/cb_offset_auto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="漏签时自动消耗（关闭则手动点日期补签）"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 修改策略卡 -->
            <LinearLayout
                android:id="@+id/policy_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/tv_policy_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="逻辑修改策略（创建后不可更改）"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">
                    <RadioButton android:id="@+id/rb_locked" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="不可修改（规则创建后锁定）" android:textColor="@color/text_primary"/>
                    <RadioButton android:id="@+id/rb_interval" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="每 N 天可修改一次" android:textColor="@color/text_primary"/>
                </RadioGroup>
                <LinearLayout
                    android:id="@+id/interval_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="间隔天数 N =" android:textColor="@color/text_primary"/>
                    <EditText android:id="@+id/et_interval" android:layout_width="80dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_input" android:inputType="number" android:padding="10dp" android:text="7" android:textColor="@color/text_primary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 天" android:textColor="@color/text_secondary"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_save"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:text="保存打卡项" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
